# ---------- Database ----------
# Development: the bundled server from `npm run db:local`.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres"
# Prisma needs this to exist. In development it is the same value.
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres"

# Neon serves two endpoints for the same database and the difference matters:
#
#   DATABASE_URL  the POOLED host — it has `-pooler` in the hostname. The app
#                 uses this, because a serverless deployment opens far more
#                 connections than Postgres will hold open.
#   DIRECT_URL    the same host WITHOUT `-pooler`. Migrations use this, because
#                 PgBouncer in transaction mode cannot run the session-level
#                 statements a migration needs.
#
# Both come from the Neon dashboard with `?sslmode=require` already on them.
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/xcc?sslmode=require"
# DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/xcc?sslmode=require"

# ---------- Auth ----------
AUTH_SECRET="replace-with-openssl-rand-base64-32"
# Leave unset in development — trustHost infers the origin per request, so the
# app works on localhost, 127.0.0.1 or a LAN IP. REQUIRED in production.
# AUTH_URL="https://your-domain.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------- Credentials Vault (AES-256-GCM) ----------
# 32 raw bytes, base64 encoded: openssl rand -base64 32
VAULT_MASTER_KEY=""
# Comma-separated retired keys, newest first, for rotation reads
VAULT_PREVIOUS_KEYS=""

# ---------- Integration provider selection ----------
# Each falls back to "mock" when unset, so the whole app runs with zero accounts.
PAYMENTS_PROVIDER="mock"      # mock | razorpay | stripe
EMAIL_PROVIDER="mock"         # mock | sendgrid | smtp
WHATSAPP_PROVIDER="mock"      # mock | meta | twilio
STORAGE_PROVIDER="local"      # local | s3 | r2

# ---------- Razorpay (INR) ----------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---------- Stripe (USD) ----------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---------- Email ----------
SENDGRID_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="billing@xcc.example.com"
EMAIL_FROM_NAME="XCC Billing"

# ---------- WhatsApp (Meta Cloud API) ----------
# Business-initiated messages REQUIRE a pre-approved template. See docs/INTEGRATIONS.md
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_TEMPLATE_INVOICE="invoice_dispatch_v1"
WHATSAPP_TEMPLATE_REMINDER="invoice_reminder_v1"

# ---------- Storage (S3 / Cloudflare R2) ----------
S3_ENDPOINT=""
S3_REGION="ap-south-1"
S3_BUCKET="xcc-crm"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---------- Jobs ----------
CRON_SECRET="replace-with-a-long-random-string"

# ---------- FX ----------
# Fallback USD->INR rate used when no live rate is configured.
FX_USD_INR_FALLBACK="86.50"
